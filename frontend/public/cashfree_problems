      <div class="contact-methods">
        <span class="contact-method">📧 <a href="mailto:ayushpatil9977@gmail.com">ayushpatil9977@gmail.com</a></span>
        <span class="contact-method">📱 <a href="tel:+919999999999">+91 99999 99999</a></span>

# ── Meilisearch ────────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=local_dev_key

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key
JINA_API_KEY=jina-your-key

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/scubasearch

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Clerk ──────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your_key
CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# ── Local encryption / admin ───────────────────────────────────────────────────
DB_ENCRYPTION_KEY=your-base64-fernet-key
ADMIN_CLERK_USER_IDS=user_abc123,user_def456

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=*
